{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {
              "id": "js/fixture-error",
              "defaultConfiguration": { "level": "error" },
              "properties": { "security-severity": "9.8" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "js/fixture-error",
          "ruleIndex": 0,
          "level": "error",
          "message": { "text": "fixture: an error-level result — the gate must exit non-zero" }
        }
      ]
    }
  ]
}
