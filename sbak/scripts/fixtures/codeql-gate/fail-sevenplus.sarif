{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {
              "id": "js/fixture-high-sev",
              "defaultConfiguration": { "level": "warning" },
              "properties": { "security-severity": "8.1" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "js/fixture-high-sev",
          "ruleIndex": 0,
          "level": "warning",
          "message": { "text": "fixture: warning-level but security-severity 8.1 — the second predicate alone must block" }
        }
      ]
    }
  ]
}
