#!/usr/bin/env sh
# @kit-version 1.0.10
# .githooks/pre-push  —  the fast lane: the tests your push affects, the open milestone's
# own tests, and the always-tagged guards, on the native leg. The full matrix (Linux-in-
# Docker + native, every test) is the `release` lane, run by /closeout, /verify and the
# v* tag workflow — never per push. `node scripts/verify-local.cjs --list` prints the lanes.
# Blocks the push on any failure. This is what replaces the per-push cloud test matrix
# under verification_locus: local_first | hybrid.
#
# Activated by: git config core.hooksPath .githooks
#   (run `node scripts/install-hooks.cjs` once after cloning).
# Emergency override: git push --no-verify  (logged, never routine; it cannot
# bypass the required PR check — see docs/gates.md).
set -e
# The append-only leg (M32.B): every commit in the push must extend its parent's ledgers,
# not only the final file against the base. The list is docs/append-only-ledgers.txt (the
# same file CI reads); no list present (Lite, or an unarmed project) means one plain line.
if [ -f docs/append-only-ledgers.txt ]; then node validators/check-append-only.cjs --per-commit --ledgers docs/append-only-ledgers.txt || exit 1; else echo "pre-push: no docs/append-only-ledgers.txt - append-only leg skipped"; fi
# The evidence path's transport check (M34.6.B): every stage commit in the pushed range (a
# single-parent commit whose diff touches .claude/evidence/<stage>/gate.json) must carry a committed
# lane_run.json for its own subject with verdict pass; it reads git's ref feed on stdin. Any other
# commit is covered by the lane below. Without scripts/evidence.cjs no stage was opened on the path.
if [ -f scripts/evidence.cjs ]; then node scripts/evidence.cjs --pre-push || exit 1; fi
node scripts/verify-local.cjs --lane fast
